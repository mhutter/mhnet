# {{ ansible_managed }}
# Template unit: one instance per space, e.g. `systemctl start
# silverbullet@notes`. Everything instance-specific either derives from the
# instance name (%i) or comes from /etc/silverbullet/%i.env.

[Unit]
Description=SilverBullet space %i
Documentation=https://silverbullet.md/
After=network-online.target
Wants=network-online.target

[Service]
User=silverbullet
Group=silverbullet

# The space folder is the entire state: plain Markdown files, created here on
# first start and seeded with an index page by SilverBullet itself.
StateDirectory=silverbullet/%i
StateDirectoryMode=0750
Environment=SB_FOLDER=%S/silverbullet/%i

# cloudflared connects to this socket directly; no TCP port is opened. The
# runtime directory (and with it any stale socket) is cleaned up on stop.
RuntimeDirectory=silverbullet/%i
Environment=SB_UNIX_SOCKET=%t/silverbullet/%i/silverbullet.sock

EnvironmentFile=/etc/silverbullet/%i.env
ExecStart=/usr/local/bin/silverbullet
Restart=on-failure
RestartSec=5s

# Hardening: the service needs nothing beyond its own space folder, its
# socket and (for the metrics endpoint) a localhost listener.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
