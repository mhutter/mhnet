# {{ ansible_managed }}
# Both datasources go through the public ingest endpoints so the same TLS
# certificate and auth apply -- the same URLs the agents push to, so once
# those point at rhea, Grafana follows.
apiVersion: 1

datasources:
  - name: VictoriaMetrics
    uid: victoriametrics
    type: prometheus
    access: proxy
    url: "{{ monitoring_metrics_url }}"
    isDefault: true
    basicAuth: true
    basicAuthUser: "{{ monitoring_remote_write_user }}"
    secureJsonData:
      basicAuthPassword: "{{ monitoring_remote_write_password }}"
    jsonData:
      timeInterval: "{{ monitoring_scrape_interval }}"

  - name: VictoriaLogs
    uid: victorialogs
    type: victoriametrics-logs-datasource
    access: proxy
    url: "{{ monitoring_logs_url }}"
    basicAuth: true
    basicAuthUser: "{{ monitoring_remote_write_user }}"
    secureJsonData:
      basicAuthPassword: "{{ monitoring_remote_write_password }}"
