# Managed by Ansible (roles/firefly).
# Firefly III's periodic housekeeping: recurring transactions, auto-budgets,
# subscription warnings and exchange rates.

[Unit]
Description=Firefly III cron job
Documentation=https://docs.firefly-iii.org/how-to/firefly-iii/advanced/cron/
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User={{ firefly_user }}
Group={{ firefly_user }}
WorkingDirectory={{ firefly_current_dir }}
ExecStart=/usr/bin/php artisan firefly-iii:cron

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths={{ firefly_storage_dir }}
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
