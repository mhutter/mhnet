{#- Values are quoted and escaped: systemd's EnvironmentFile parser treats
    quotes and backslashes specially. -#}
{% macro env(value) %}"{{ value | replace('\\', '\\\\') | replace('"', '\\"') }}"{% endmacro %}
# {{ ansible_managed }} -- SilverBullet instance "{{ item.name }}".
# https://silverbullet.md/Install/Configuration
# SB_FOLDER and SB_UNIX_SOCKET derive from the instance name and are set in
# the unit; everything space-specific lives here.

# Single-user credentials, user:password.
SB_USER={{ env(item.user) }}
SB_NAME={{ env(item.title | default(item.name)) }}
{% if item.index_page is defined %}
SB_INDEX_PAGE={{ env(item.index_page) }}
{% endif %}
{% if item.description is defined %}
SB_DESCRIPTION={{ env(item.description) }}
{% endif %}
{% if item.read_only | default(false) %}
SB_READ_ONLY=1
{% endif %}

# Plugs may otherwise run shell commands as the silverbullet user.
SB_SHELL_BACKEND={{ silverbullet_shell_backend }}

# Prometheus counters, bound to SB_HOSTNAME (127.0.0.1) and scraped by vmagent.
SB_METRICS_PORT={{ item.metrics_port }}
