# Managed by Ansible (roles/pocket_id).
# Rootless Quadlet unit, generated by podman inside pocket-id's own systemd
# --user instance. See https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Unit]
Description=Pocket ID

[Container]
Image={{ pocket_id_image }}
AutoUpdate=registry

Volume=%h/data:/app/data
PublishPort=127.0.0.1:{{ pocket_id_port }}:1411
EnvironmentFile=%h/pocket-id.env

HealthCmd=/app/pocket-id healthcheck
HealthInterval=90s
HealthTimeout=5s
HealthRetries=2
HealthStartPeriod=10s

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
