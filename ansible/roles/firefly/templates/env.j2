# Managed by Ansible (roles/firefly).
# Only the values that differ from Firefly III's own defaults are set here;
# everything else comes from config/*.php. See .env.example in the release
# for the full list.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://{{ firefly_app_hostname }}
SITE_OWNER={{ firefly_site_owner }}
APP_KEY={{ firefly_app_key }}

DEFAULT_LANGUAGE={{ firefly_language }}
DEFAULT_LOCALE={{ firefly_locale }}
TZ={{ firefly_timezone }}

# Kept for the day upstream wires it up again: 6.6.6 uses Laravel's default
# TrustProxies middleware without configuring it, so this value is ignored
# and the https scheme is asserted in the nginx site instead.
TRUSTED_PROXIES=*

# Logs go to the journal (and from there to VictoriaLogs) instead of piling
# up in storage/logs.
LOG_CHANNEL=syslog
APP_LOG_LEVEL=notice

# Local socket + peer authentication: the php-fpm pool runs as the system
# user {{ firefly_db_user }}, which is also the owning database role, so no
# password is involved.
DB_CONNECTION=pgsql
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_DATABASE={{ firefly_db_name }}
DB_USERNAME={{ firefly_db_user }}
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Firefly III's own login. It speaks no OIDC, so pocket-id is not in the
# picture; close registration in Administration > Settings once the first
# account exists, and turn on 2FA in the profile.
AUTHENTICATION_GUARD=web

# No SMTP configured: mails (password resets, subscription warnings) are
# written to the log only.
MAIL_MAILER=log

FIREFLY_III_LAYOUT=v1
